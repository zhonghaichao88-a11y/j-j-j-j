# 代理地址（和订单流 / V7 的 .env 里 PROXY_URL 一样）。不用代理就留空。
PROXY_URL=

# 欧易 API 密钥：只在切换到实盘时才用到。模拟盘不用填。
# 建议开子账户、只给"交易"权限，不要给"提币"权限。
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# 实盘总开关：改成 1 并重启，网页上"切换到实盘"才能用（还要再输入确认口令）。
SB_ALLOW_LIVE=0

# 手机推送（可选，填一个就行）：开仓、平仓、下单失败时推到微信
OF_PUSHPLUS_TOKEN=
OF_SERVERCHAN_KEY=
