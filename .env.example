# ===== 欧易 API 凭证 =====
# 在欧易 App -> 个人中心 -> API 与连接凭证 -> 创建 API Key 获取
# 权限必须勾选「交易」，不要勾选「提现」
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ===== 运行环境 =====
# ALPHA-X 实盘总开关：默认开启，仍需在网页确认 ALPHA-X-LIVE 后启动交易。
ALPHA_LIVE_ALLOWED=1
# 实盘 API 二次保护密钥
ALPHA_LIVE_API_KEY=888888
# 实盘 API 二次保护密钥：只有网页/请求同时提供此密钥才允许启动/停止真实交易
# 新安装默认实盘环境；配置生产凭证后，在页面确认并启动交易。
OKX_DEMO_MODE=0

# API 基础地址(国内用户可能需要代理或使用 aws 节点)
# 官方: https://www.okx.com
# AWS:  https://www.okx.com
OKX_BASE_URL=https://www.okx.com

# 代理地址(国内用户需要, 留空则自动探测本地代理端口)
# Clash默认: http://127.0.0.1:7890
# V2RayN默认: http://127.0.0.1:10809
PROXY_URL=

# ===== 交易参数 =====
# 交易对, 永续合约格式: BTC-USDT-SWAP, 现货格式: BTC/USDT
TRADING_SYMBOL=BTC-USDT-SWAP
# 交易类型: swap(永续合约) / spot(现货)
TRADING_TYPE=swap
# 保证金模式: cross(全仓) / isolated(逐仓)
MARGIN_MODE=cross
# 杠杆倍数 (1-125, 合约有效)
LEVERAGE=10
# 每次下单使用的 USDT 数量
ORDER_AMOUNT_USDT=100
# K线周期: 1m/3m/5m/15m/30m/1H/2H/4H/6H/12H/1D
TIMEFRAME=15m
# 策略名称: ma_cross / rsi / grid / kline_pattern / smart_key_level / ml_predict(机器学习,需先训练)
STRATEGY_NAME=ma_cross

# ===== 风控参数 =====
# 单笔最大亏损 USDT
MAX_LOSS_PER_TRADE=20
# 单日最大亏损 USDT, 达到后停止交易
DAILY_MAX_LOSS=100
# 最大持仓数量
MAX_POSITIONS=3
# 止损百分比 (相对于入场价)
STOP_LOSS_PCT=0.02
# 止盈百分比
TAKE_PROFIT_PCT=0.04
# 真实下单模式 (false=真实交易, true=只模拟不下单)
DRY_RUN=false

# ===== API 服务 =====
API_HOST=127.0.0.1
API_PORT=8000
API_SECRET_KEY=change_this_to_a_random_string

# ALPHA-X ULTRA 实盘节点（按你的 OKX 账户所属地区填写官方生产域名）
# 例如：美国/澳洲账户通常使用 https://us.okx.com；欧洲账户通常使用 https://eea.okx.com
ALPHA_OKX_BASE_URL=https://www.okx.com
ALPHA_LIVE_ALLOWED=0

# ALPHA-X 5.0 private WebSocket (可按账户区域覆盖)
ALPHA_OKX_WS_PRIVATE_URL=wss://ws.okx.com:8443/ws/v5/private

# ALPHA-X 7.0 operational safety
ALPHA_API_KEY=
ALPHA_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ALPHA-X 10.0 production safety
# API should normally bind localhost only; expose externally only behind an authenticated reverse proxy.
ALPHA_BIND_HOST=127.0.0.1
ALPHA_API_KEY=
ALPHA_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ALPHA_AUTOPROMOTE=0
ALPHA_MAX_DAILY_LOSS_PCT=0.02
ALPHA_MAX_WS_STALE_SEC=60

# ALPHA-X 16.0 real-data production (public market data only; no trading)
ALPHA_REAL_DATA_AUTOSTART=0
ALPHA_REAL_DATA_DB=./alpha_market_data.sqlite3
ALPHA_REAL_DATA_SYMBOLS=BTC-USDT-SWAP
ALPHA_REAL_DATA_INTERVAL=3
ALPHA_REAL_DATA_BAR_REFRESH=60
ALPHA_REAL_DATA_FUNDING_REFRESH=900
# 0 = no historical bootstrap; use a positive page count to bootstrap completed 15m bars/funding.
ALPHA_REAL_DATA_BOOTSTRAP_PAGES=0

# 前端来源限制（本地启动默认仅允许本机网页）
ALPHA_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ALPHA-X 简易手机远程访问（由启动脚本自动生成访问密钥）
ALPHA_REMOTE_MODE=0
ALPHA_REMOTE_API_KEY=

# ====================================================================
# FAST 快速实盘：maker(post-only 限价)进场 —— 用来把手续费从 taker 降到 maker
# 重要：先在 OKX_DEMO_MODE=1 模拟盘挂几天，确认"挂得出去、能成交、TP/SL正常"，再切实盘！
# ====================================================================
# 进场方式：market=市价taker(默认,行为不变)；maker=只挂post-only限价,不成交就撤单不追(推荐先模拟)；
#           maker_market=先挂post-only,超时再回退市价(保证成交,但可能又付taker)
OKX_FAST_ENTRY_MODE=market
# 每笔 post-only 挂单最长等待秒数（超时撤单不追）
OKX_FAST_MAKER_TTL=45
# 挂单提交瞬间被拒(报价会立即吃单)时，按最新盘口重挂的次数
OKX_FAST_MAKER_REPRICE=2
# 在最优买/卖价基础上向盘口中间让多少个基点(bps,1bp=0.01%)，提高成交概率；post-only保证不会变taker
OKX_FAST_MAKER_IMPROVE_BPS=0.5
# 价格朝有利方向跑掉多少bps就放弃本单(不追价)
OKX_FAST_MAKER_CHASE_BPS=12
# 一次挂单未成交后，同一币种冷却多少秒再挂，避免反复挂撤
OKX_FAST_MAKER_SKIP_SECONDS=240

# ====================================================================
# 策略引擎版本（也可在网页“🧠 FAST 策略引擎版本”卡片点选，网页设置优先并持久化）：
#   v4       = 区间双引擎，默认只跑区间均值回归（推荐，maker下约66%/PF1.11）
#   v4_trend = v4 基础上额外打开趋势延续 sleeve（实验，该类单未验证扣费后正edge）
#   v3       = 完全回退旧版纯裸K（taker下约38%/PF0.57亏钱，仅对比/紧急回退，勿实盘）
OKX_FAST_ENGINE=v4

# ====================================================================
# v5-XS 截面中性篮子（组合层，多空各5、固定31小币池、每日调仓）—— 定时调仓/看门狗/maker/熔断
# 网页“🧺 v5-XS 篮子”卡片里的“每日自动调仓”面板也能改，网页设置优先并持久化到 alpha_xs_runtime.json
# ====================================================================
# 定时自动调仓总开关：默认 0 关闭（必须手动②③）。设 1 后每天到点自动真实下单（多空各5），请先模拟盘验证。
OKX_XS_AUTO_ENABLED=0
# 每日自动调仓时间（UTC，24小时制 HH:MM）。北京=+8小时，00:30 = 北京 08:30（避开资金费率整点结算）。
OKX_XS_AUTO_TIME=00:30
# 看门狗快出：默认 1 开。每天调仓前剔除无K线/24h成交额低于池中位数1/10的坏币，有持仓则平仓，不再整批拒单。
OKX_XS_WATCHDOG=1
# 调仓单先挂 maker 限价（省手续费），超时未成交自动转市价保证调仓到位。默认 1 开。
OKX_XS_MAKER=1
# 每条 maker 挂单等待秒数，超时未成交余量转市价（日内一次，8~15 秒较稳妥）。
OKX_XS_MAKER_TTL=8
# maker 挂单向盘口中间让多少基点（1bp=0.01%），提高成交率，仍保证不越过对手价、不吃单。
OKX_XS_MAKER_IMPROVE_BPS=0.5
# -10% 宽熔断：默认 0 关。设 1 后，较上一调仓日权益回撤达到阈值时当天全平、不开新仓，次日恢复。
OKX_XS_BREAKER=0
OKX_XS_BREAKER_PCT=-0.10

# V6.2 fresh-install research default; existing saved selection takes precedence.
OKX_FAST_ENGINE=v62
