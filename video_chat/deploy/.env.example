# 你的域名（需已备案并解析到服务器 IP）和服务器公网 IP
DOMAIN=seeu.example.com
PUBLIC_IP=1.2.3.4

# 必改：随机长字符串（例如 openssl rand -hex 32 生成）
SEEU_SECRET=change-me
SEEU_ADMIN_TOKEN=change-me-too
DB_PASSWORD=change-me-db

# TURN 中转账号（自己设）
SEEU_TURN_USER=seeu
SEEU_TURN_PASS=change-me-turn

# 0 = 正式模式（短信必须真发、关闭模拟支付）；1 = 开发模式
SEEU_DEV=0
SEEU_HOST_SHARE=0.5

# 对外访问地址（支付回跳用）
SEEU_PUBLIC_URL=https://seeu.example.com
SEEU_DATA_DIR=/data/app

# ---- 以下第三方服务开通后再填，没填的会自动禁用 ----
# 阿里云短信
SEEU_ALIYUN_AK=
SEEU_ALIYUN_SK=
SEEU_SMS_SIGN=
SEEU_SMS_TEMPLATE=
# 实名核验（身份证二要素）
SEEU_REALNAME_URL=
SEEU_REALNAME_APPCODE=
# 支付宝（密钥文件放在 deploy/keys/ 下，容器里路径是 /data/keys/）
SEEU_ALIPAY_APP_ID=
SEEU_ALIPAY_PRIVATE_KEY_FILE=
SEEU_ALIPAY_PUBLIC_KEY_FILE=
# 微信支付
SEEU_WXPAY_APPID=
SEEU_WXPAY_MCHID=
SEEU_WXPAY_SERIAL=
SEEU_WXPAY_PRIVATE_KEY_FILE=
SEEU_WXPAY_PUBLIC_KEY_FILE=
SEEU_WXPAY_APIV3_KEY=
# 推送
SEEU_VAPID_SUB=mailto:admin@example.com
SEEU_FCM_SERVICE_ACCOUNT=
SEEU_APNS_KEY_FILE=
SEEU_APNS_KEY_ID=
SEEU_APNS_TEAM_ID=
SEEU_APNS_TOPIC=com.seeu.videochat
