# 你的域名（需已备案并解析到服务器 IP）和服务器公网 IP
DOMAIN=seeu.example.com
PUBLIC_IP=1.2.3.4

# 必改：随机长字符串（例如 openssl rand -hex 32 生成）
SEEU_SECRET=change-me
SEEU_ADMIN_TOKEN=change-me-too
DB_PASSWORD=change-me-db

# TURN 中转账号（自己设）
SEEU_TURN_USER=seeu
SEEU_TURN_PASS=change-me-turn

# 0 = 正式模式（短信必须真发、关闭模拟支付）；1 = 开发模式
SEEU_DEV=0
SEEU_HOST_SHARE=0.5
