# 代理地址（和 V7 的 .env 里 PROXY_URL 一样）。不用代理就留空。
PROXY_URL=

# 欧易 API 密钥：只在切换到实盘时才用到。模拟盘不用填。
# 建议开子账户、只给"交易"权限，不要给"提币"权限。
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# 实盘总开关：改成 1 并重启，网页上才会出现"切换到实盘"按钮（还要再输入确认口令）。
OF_ALLOW_LIVE=0

# V7 文件夹路径（启动时读 V7 录的实盘数据：自动选币、补爆仓/盘口/持仓历史）。放在 V7 旁边会自动找到，可以不填。
OF_V7_DATA=

# 手机推送（可选，填一个就行）：开仓、平仓、下单失败时推到微信
# pushplus.plus 的 token：
OF_PUSHPLUS_TOKEN=
# 或者 Server酱（sct.ftqq.com）的 SendKey：
OF_SERVERCHAN_KEY=
